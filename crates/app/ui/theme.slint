import "fonts/Geist-Regular.ttf";
import "fonts/Geist-Medium.ttf";
import "fonts/Geist-SemiBold.ttf";
import "fonts/Geist-Bold.ttf";
import "fonts/GeistMono-Regular.ttf";
import "fonts/GeistMono-Medium.ttf";
export { Icons } from "icons.slint";

// Clean dark: near-black surfaces in three steps, hairline borders, one soft teal accent.
export global Theme {
    out property <color> bg: #0e0f12;
    out property <color> sidebar: #0e0f12;
    out property <color> surface: #16181d;
    out property <color> raised: #1c1f25;
    out property <color> hover: #22252c;
    out property <color> input-bg: #0e0f12;
    out property <color> border: #23262d;
    out property <color> border-strong: #2a2e36;
    out property <color> text: #eceef2;
    out property <color> text-2: #c3c8d0;
    out property <color> muted: #9aa1ad;
    out property <color> subtle: #7c828d;
    out property <color> faint: #5f6672;
    out property <color> accent: #7dd3c0;
    out property <color> accent-hover: #93ddcc;
    out property <color> accent-soft: #18241f;
    out property <color> on-accent: #0b1412;
    out property <color> success: #7dd3c0;
    out property <color> warning: #f0b35a;
    out property <color> warning-soft: #2a2114;
    out property <color> warning-text: #e8d5b5;
    out property <color> danger: #e5484d;
    out property <color> danger-hover: #ec5d62;
    out property <color> danger-soft: #2c1517;
    out property <color> danger-text: #ff9c9f;
    out property <color> scrim: #050608b8;
    out property <length> radius: 12px;
    out property <length> radius-lg: 16px;
    out property <string> mono: "Geist Mono";
}
