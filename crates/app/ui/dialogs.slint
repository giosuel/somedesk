import { Theme, Icons } from "theme.slint";
import { Icon, PrimaryButton, GhostButton, Card, Avatar, Spinner, Checkbox } from "widgets.slint";

component Backdrop inherits Rectangle {
    background: #05060acc;
    TouchArea { }
}

export component IncomingDialog inherits Backdrop {
    in property <string> user;
    in property <string> user-letter;
    in property <string> device;
    in property <string> fingerprint;
    in property <bool> same-account;
    /// Extra guidance, e.g. about the desktop's own permission dialog on Wayland.
    in property <string> note;
    callback answer(bool);
    Card {
        width: 440px;
        height: body.preferred-height;
        body := VerticalLayout {
            padding: 28px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 14px;
                Avatar { letter: root.user-letter; size: 48px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: "Incoming connection"; color: Theme.text; font-size: 18px; font-weight: 700; }
                    Text { text: root.user + " · " + root.device; color: Theme.muted; font-size: 13px; }
                }
            }
            Text {
                text: root.user + " wants to view and control this computer. They will see your screen and can use your mouse and keyboard.";
                color: Theme.text;
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle {
                border-radius: 10px;
                background: Theme.input-bg;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Icon { d: Icons.fingerprint; size: 14px; color: Theme.muted; stroke: 1.8px; }
                        Text {
                            text: root.same-account ? "Verified: one of your own devices" : "Their identity fingerprint";
                            color: root.same-account ? Theme.success : Theme.muted;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                    Text { text: root.fingerprint; color: #c9c3ff; font-size: 13px; font-family: Theme.mono; }
                }
            }
            if !root.same-account: Text {
                text: "Only accept if you are expecting this connection.";
                color: Theme.warning;
                font-size: 12px;
            }
            if root.note != "": Rectangle {
                border-radius: 10px;
                background: Theme.accent-soft;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Icon { d: Icons.monitor; size: 16px; color: #b9b1ff; stroke: 1.8px; }
                    Text { text: root.note; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                GhostButton { width: 120px; text: "Decline"; clicked => { root.answer(false); } }
                PrimaryButton { width: 140px; text: "Accept"; clicked => { root.answer(true); } }
            }
        }
    }
}

export component OutgoingDialog inherits Backdrop {
    in property <string> target;
    callback cancel();
    Card {
        width: 380px;
        height: body.preferred-height;
        body := VerticalLayout {
            padding: 30px;
            spacing: 16px;
            alignment: center;
            Rectangle {
                height: 64px;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 18px;
                    background: Theme.accent-soft;
                    Icon { d: Icons.monitor; size: 30px; color: #b9b1ff; }
                }
            }
            Text {
                text: "Connecting to " + root.target;
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Waiting for someone at the other computer to accept…";
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Spinner { }
            HorizontalLayout {
                alignment: center;
                GhostButton { width: 120px; text: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    height: 44px;
    width: row.preferred-width + 32px;
    border-radius: 12px;
    background: #1d2230f2;
    border-width: 1px;
    border-color: root.error ? #f0526a66 : Theme.border-strong;
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000080;
    row := HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Rectangle {
            y: (parent.height - 8px) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.error ? Theme.danger : Theme.success;
        }
        Text { text: root.text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
    }
}

/// Shown once whenever a new recovery key is created. The user must confirm they stored it.
export component RecoveryKeyDialog inherits Backdrop {
    /// The key, as three lines of `XXXX-XXXX-XXXX`.
    in property <string> key;
    /// Why this key is being shown (new account, replaced after a reset, ...).
    in property <string> reason;
    in property <bool> copied;
    callback copy();
    callback done();
    property <bool> saved;
    Card {
        width: 480px;
        height: body.preferred-height;
        body := VerticalLayout {
            padding: 28px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 14px;
                    background: Theme.warning-soft;
                    Icon { d: Icons.key; size: 24px; color: Theme.warning; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: "Save your recovery key"; color: Theme.text; font-size: 18px; font-weight: 700; }
                    Text { text: root.reason; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                }
            }
            Text {
                text: "If you forget your password, this key is the only way back into your account. Nobody else can reset it for you — not even the server's administrator.";
                color: Theme.text;
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle {
                border-radius: 12px;
                background: Theme.input-bg;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Text {
                        text: root.key;
                        color: #e3defe;
                        font-size: 20px;
                        font-family: Theme.mono;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        GhostButton {
                            text: root.copied ? "Copied" : "Copy to clipboard";
                            icon: Icons.copy;
                            button-height: 34px;
                            clicked => { root.copy(); }
                        }
                    }
                }
            }
            Text {
                text: "Store it in a password manager or print it out, and keep it away from this computer.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Checkbox { text: "I have stored my recovery key somewhere safe"; checked <=> root.saved; }
            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    text: "Continue";
                    enabled: root.saved;
                    clicked => { if (root.saved) { root.done(); } }
                }
            }
        }
    }
}

export struct TransferItem {
    id: int,
    upload: bool,
    name: string,
    detail: string,
    /// 0..1
    progress: float,
    /// 0 waiting for the other side, 1 running, 2 done, 3 failed
    state: int,
}

/// Floating list of file transfers in this session.
export component TransfersPanel inherits Rectangle {
    in property <[TransferItem]> items;
    callback cancel(int, bool);
    callback clear();
    width: 340px;
    height: body.preferred-height;
    border-radius: 14px;
    background: #171b25f5;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000090;
    body := VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Icon { y: (parent.height - self.height) / 2; d: Icons.file; size: 15px; color: Theme.muted; stroke: 1.8px; }
            Text { text: "File transfers"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "Clear";
                color: clear-ta.has-hover ? Theme.text : Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                clear-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clear(); } }
            }
        }
        for item in root.items: HorizontalLayout {
            spacing: 10px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: item.state == 3 ? Theme.danger-soft : item.state == 2 ? Theme.success-soft : Theme.accent-soft;
                Icon {
                    d: item.upload ? Icons.upload : Icons.download;
                    size: 15px;
                    stroke: 2px;
                    color: item.state == 3 ? Theme.danger : item.state == 2 ? Theme.success : #b9b1ff;
                }
            }
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                Text { text: item.name; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                if item.state <= 1: Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.border;
                    Rectangle {
                        x: 0;
                        width: parent.width * Math.max(0.02, item.progress);
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.accent-gradient;
                        animate width { duration: 150ms; }
                    }
                }
                Text {
                    text: item.detail;
                    color: item.state == 3 ? Theme.danger : Theme.muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            if item.state <= 1: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                border-radius: 6px;
                background: x-ta.has-hover ? Theme.card-hover : transparent;
                Icon { d: Icons.x; size: 13px; color: Theme.muted; }
                x-ta := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(item.id, item.upload); } }
            }
        }
    }
}

/// The other computer wants to send us a file.
export component FileOfferDialog inherits Backdrop {
    in property <string> peer;
    in property <string> name;
    in property <string> size;
    callback answer(bool);
    Card {
        width: 420px;
        height: body.preferred-height;
        body := VerticalLayout {
            padding: 26px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 46px;
                    height: 46px;
                    border-radius: 13px;
                    background: Theme.accent-soft;
                    Icon { d: Icons.download; size: 22px; color: #b9b1ff; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: "Receive a file?"; color: Theme.text; font-size: 17px; font-weight: 700; }
                    Text { text: root.peer + " wants to send you a file."; color: Theme.muted; font-size: 13px; }
                }
            }
            Rectangle {
                border-radius: 10px;
                background: Theme.input-bg;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Icon { y: (parent.height - self.height) / 2; d: Icons.file; size: 18px; color: Theme.muted; stroke: 1.8px; }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: root.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: root.size; color: Theme.muted; font-size: 12px; }
                    }
                }
            }
            Text {
                text: "Only accept files you expect. Received files are saved to your SomeDesk downloads folder.";
                color: Theme.subtle;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                GhostButton { width: 110px; text: "Decline"; clicked => { root.answer(false); } }
                PrimaryButton { width: 120px; text: "Save"; clicked => { root.answer(true); } }
            }
        }
    }
}
