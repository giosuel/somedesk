// The phone layout (Android): the same screens as the desktop, in one column with a bottom
// navigation bar, and a full-screen session with touch controls. AppWindow picks these pages
// when `mobile` is set and passes them the same properties as the desktop pages.

import { Theme, Icons } from "theme.slint";
import { Logo, Icon, Field, PrimaryButton, GhostButton, LinkText, Card, SectionTitle, Switch, Avatar, Divider, Spinner } from "widgets.slint";
import { SetupForm } from "login.slint";
import { DeviceItem, RecentItem, HomeView, BookItem } from "home.slint";
import { BookList } from "book.slint";
import { SettingsView } from "settings.slint";
import { MonitorChoice, MonitorPicker } from "session.slint";

// ---------------------------------------------------------------------------------- first start

export component MobileSetupPage inherits Rectangle {
    in property <string> error;
    in property <bool> busy;
    in-out property <string> server;
    in-out property <string> name;
    callback submit();
    background: Theme.bg;

    Flickable {
        content-height: Math.max(self.height, content.preferred-height);
        content-width: self.width;
        content := VerticalLayout {
            padding: 24px;
            padding-top: 28px;
            spacing: 28px;
            alignment: start;
            Logo { mark-size: 30px; font-size: 17px; }
            VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Your computers,\nwithin reach.";
                    color: Theme.text;
                    font-size: 30px;
                    font-weight: 600;
                    letter-spacing: -0.9px;
                }
                Text {
                    text: "Remote access you host yourself, encrypted end to end. Free, for good.";
                    color: Theme.muted;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
            SetupForm {
                server <=> root.server;
                name <=> root.name;
                error: root.error;
                busy: root.busy;
                submit => { root.submit(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------------- home

component TabButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    horizontal-stretch: 1;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Rectangle {
            height: 28px;
            Rectangle {
                width: 52px;
                height: 28px;
                border-radius: 14px;
                background: root.active ? Theme.accent-soft : transparent;
                Icon { d: root.icon; size: 19px; color: root.active ? Theme.accent : Theme.subtle; }
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.subtle;
            font-size: 11px;
            font-weight: root.active ? 500 : 400;
            horizontal-alignment: center;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component MobileDeviceRow inherits Rectangle {
    in property <DeviceItem> device;
    callback connect(string);
    height: 64px;
    background: row-ta.pressed ? Theme.raised : transparent;
    row-ta := TouchArea { clicked => { if (!root.device.is-self && root.device.online) { root.connect(root.device.id); } } }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: root.device.online ? Theme.accent-soft : #1f2228;
            Icon { d: Icons.monitor; size: 18px; stroke: 1.8px; color: root.device.online ? Theme.accent : Theme.subtle; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.device.name + (root.device.is-self ? " · this phone" : "");
                color: root.device.online || root.device.is-self ? Theme.text : #a3a9b4;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: (root.device.online ? "Online" : "Offline") + " · " + root.device.id-label;
                color: root.device.online ? Theme.accent : Theme.subtle;
                font-size: 12px;
            }
        }
        if !root.device.is-self && root.device.online: Icon { y: (parent.height - self.height) / 2; d: Icons.connect; size: 18px; color: Theme.accent; }
    }
}

component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    Text { text: root.title; color: Theme.text; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; }
    if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
}

export component MobileHomePage inherits Rectangle {
    in property <string> my-id;
    in-out property <string> my-device-name;
    in property <bool> signed-in;
    in property <string> username;
    in property <string> user-letter;
    in property <string> greeting;
    in property <string> fingerprint;
    in property <string> server-label;
    in property <bool> online;
    in property <string> status-text;
    in property <[DeviceItem]> devices;
    in property <[BookItem]> book;
    in property <[RecentItem]> recents;
    in property <bool> connect-busy;
    in-out property <string> connect-id;
    in property <bool> account-2fa;
    in-out property <bool> share-clipboard;
    in-out property <bool> allow-direct;
    in-out property <HomeView> view: HomeView.connect;
    /// What the tour points at ("" when it is not running).
    in property <string> tour-target;
    callback start-tour();
    /// The soft keyboard is open: hide the navigation so the content has the room.
    in property <bool> keyboard-open;
    callback allow-direct-changed(bool);
    callback connect(string);
    callback connect-with-password(string);
    callback share-clipboard-changed(bool);
    callback rename-device(string);
    callback sign-in();
    callback create-account();
    callback sign-out();
    callback totp-setup();
    callback totp-disable();
    callback book-edit(string);
    callback book-remove(string);
    callback book-add();
    background: Theme.bg;

    // Back goes to the first tab, and leaves the app from there.
    back := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Back && root.view != HomeView.connect) {
                root.view = HomeView.connect;
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // Top bar
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 10px;
                Logo { mark-size: 26px; font-size: 16px; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 28px;
                    width: status.preferred-width + 22px;
                    border-radius: 14px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    status := HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        Rectangle {
                            y: (parent.height - 7px) / 2;
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: root.online ? Theme.accent : Theme.warning;
                        }
                        Text { text: root.status-text; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    }
                }
            }
        }

        // Content
        Rectangle {
            vertical-stretch: 1;

            if root.view == HomeView.connect: Flickable {
                content-height: Math.max(self.height, connect-content.preferred-height);
                content-width: self.width;
                connect-content := VerticalLayout {
                    padding: 18px;
                    padding-top: 8px;
                    spacing: 16px;
                    alignment: start;
                    Heading { title: root.greeting; subtitle: "Reach one of your computers."; }
                    Card {
                        highlighted: root.tour-target == "connect";
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            SectionTitle { text: "Connect to a computer"; }
                            Field {
                                placeholder: "123 456 789";
                                field-height: 54px;
                                font-size: 22px;
                                font-family: Theme.mono;
                                text <=> root.connect-id;
                                enabled: !root.connect-busy;
                                accepted => { root.connect(root.connect-id); }
                            }
                            PrimaryButton {
                                height: 48px;
                                text: "Connect";
                                icon: Icons.connect;
                                busy: root.connect-busy;
                                enabled: root.online;
                                clicked => { root.connect(root.connect-id); }
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text { text: "Nobody there?"; color: Theme.subtle; font-size: 13px; vertical-alignment: center; }
                                LinkText { text: "Use its password"; font-size: 13px; clicked => { root.connect-with-password(root.connect-id); } }
                            }
                            if root.recents.length > 0: VerticalLayout {
                                spacing: 2px;
                                Text { text: "Recent"; color: Theme.subtle; font-size: 12px; }
                                for r in root.recents: Rectangle {
                                    height: 42px;
                                    border-radius: 10px;
                                    background: recent-ta.pressed ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        spacing: 10px;
                                        Icon { y: (parent.height - self.height) / 2; d: Icons.monitor; size: 16px; color: Theme.subtle; }
                                        Text { text: r.label; color: Theme.text-2; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        Icon { y: (parent.height - self.height) / 2; d: Icons.connect; size: 16px; color: Theme.accent; }
                                    }
                                    recent-ta := TouchArea { clicked => { root.connect(r.id); } }
                                }
                            }
                        }
                    }
                    if root.signed-in && root.devices.length > 1: Card {
                        VerticalLayout {
                            padding-top: 16px;
                            padding-bottom: 6px;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                padding-bottom: 4px;
                                spacing: 8px;
                                SectionTitle { text: "My devices"; }
                                Text { text: root.devices.length; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
                            }
                            for d in root.devices: MobileDeviceRow { device: d; connect(id) => { root.connect(id); } }
                        }
                    }
                }
            }

            if root.view == HomeView.book: Flickable {
                content-height: Math.max(self.height, book-content.preferred-height);
                content-width: self.width;
                book-content := VerticalLayout {
                    padding: 18px;
                    padding-top: 8px;
                    spacing: 16px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 10px;
                        Heading {
                            title: "Address book";
                            subtitle: root.signed-in ? "Synced, end-to-end encrypted, with your account." : "Sign in to have it on all your devices.";
                        }
                        PrimaryButton { y: 2px; height: 38px; icon: Icons.plus; clicked => { root.book-add(); } }
                    }
                    Card {
                        highlighted: root.tour-target == "book";
                        if root.book.length == 0: Text {
                            x: 18px;
                            width: parent.width - 36px;
                            text: "Nothing here yet. Add a computer by its ID.";
                            color: Theme.subtle;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                        BookList {
                            padding: 6px;
                            items: root.book;
                            connect(id) => { root.connect(id); }
                            edit(id) => { root.book-edit(id); }
                            remove(id) => { root.book-remove(id); }
                        }
                    }
                }
            }

            if root.view == HomeView.settings: Flickable {
                content-height: Math.max(self.height, settings-content.preferred-height);
                content-width: self.width;
                settings-content := SettingsView {
                    mobile: true;
                    can-host: false;
                    device-name <=> root.my-device-name;
                    my-id: root.my-id;
                    fingerprint: root.fingerprint;
                    server-label: root.server-label;
                    signed-in: root.signed-in;
                    username: root.username;
                    user-letter: root.user-letter;
                    account-2fa: root.account-2fa;
                    share-clipboard <=> root.share-clipboard;
                    allow-direct <=> root.allow-direct;
                    tour-target: root.tour-target;
                    rename-device(n) => { root.rename-device(n); }
                    share-clipboard-changed(v) => { root.share-clipboard-changed(v); }
                    allow-direct-changed(v) => { root.allow-direct-changed(v); }
                    sign-in => { root.sign-in(); }
                    create-account => { root.create-account(); }
                    sign-out => { root.sign-out(); }
                    totp-setup => { root.totp-setup(); }
                    totp-disable => { root.totp-disable(); }
                    start-tour => { root.start-tour(); }
                }
            }
        }

        // Bottom navigation
        if !root.keyboard-open: Rectangle {
            height: 66px;
            background: #121418;
            Rectangle { y: 0; height: 1px; background: #1f2228; }
            HorizontalLayout {
                padding-top: 4px;
                TabButton { text: "Connect"; icon: Icons.connect; active: root.view == HomeView.connect; clicked => { root.view = HomeView.connect; } }
                TabButton { text: "Address book"; icon: Icons.book; active: root.view == HomeView.book; clicked => { root.view = HomeView.book; } }
                TabButton { text: "Settings"; icon: Icons.settings; active: root.view == HomeView.settings; clicked => { root.view = HomeView.settings; } }
            }
        }
    }
}

// ---------------------------------------------------------------------------------- session

/// A square toolbar button that can stay switched on.
component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <bool> on;
    in property <color> fg: Theme.text-2;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: root.on ? Theme.accent-soft : ta.pressed ? Theme.raised : transparent;
    Icon { d: root.icon; size: 19px; color: root.on ? Theme.accent : root.fg; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// A key on the row of extra keys above the soft keyboard.
component KeyCap inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;
    width: Math.max(44px, label-text.preferred-width + 22px);
    height: 36px;
    border-radius: 8px;
    background: root.on ? Theme.accent-soft : ta.pressed ? Theme.hover : Theme.raised;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border-strong;
    label-text := Text {
        text: root.label;
        color: root.on ? Theme.accent : Theme.text-2;
        font-size: 13px;
        font-weight: 500;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// The remote screen, filling the phone. Tap to click, long-press for a right click, drag to
/// drag; in scroll mode, dragging scrolls. The keyboard button opens the soft keyboard with a
/// row of keys phones lack (Esc, Tab, Ctrl, Alt, arrows).
export component MobileSessionPage inherits Rectangle {
    in property <string> peer;
    in property <string> peer-letter;
    in property <image> frame;
    in property <bool> has-frame;
    in property <string> latency;
    in property <string> fps;
    in property <bool> view-only;
    in property <string> route: "Encrypted";
    in property <[MonitorChoice]> monitors;
    in property <int> monitor-selected: -1;
    callback select-monitor(int);
    callback disconnect();
    callback pointer-moved(length, length, length, length);
    callback pointer-button(int, bool);
    callback scroll(length, length);
    callback key(string, bool);
    /// The hidden input's text (see below); the controller resets it when it runs low.
    in-out property <string> soft-text;
    /// The hidden input's text after an edit, with the latched modifiers.
    callback soft-input(string, bool, bool);
    /// One key from the extra row, as Slint key text, with the latched modifiers.
    callback soft-key(string, bool, bool);

    property <bool> scroll-mode;
    property <bool> keyboard-open: soft.has-focus;
    property <bool> ctrl;
    property <bool> alt;
    // Gesture state
    property <bool> dragging;
    property <bool> long-pressed;
    property <length> last-x;
    property <length> last-y;
    background: #0a0b0d;

    function send-key(text: string) {
        root.soft-key(text, root.ctrl, root.alt);
        root.ctrl = false;
        root.alt = false;
    }

    VerticalLayout {
        // Toolbar
        Rectangle {
            height: 52px;
            background: #121418;
            Rectangle { y: parent.height - 1px; height: 1px; background: #1f2228; }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 8px;
                spacing: 6px;
                ToolButton { y: (parent.height - self.height) / 2; icon: Icons.x; fg: Theme.danger-text; clicked => { root.disconnect(); } }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text { text: root.peer; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                    HorizontalLayout {
                        spacing: 5px;
                        Icon { y: (parent.height - self.height) / 2; d: root.view-only ? Icons.eye : Icons.lock; size: 11px; color: root.view-only ? Theme.warning : Theme.accent; stroke: 2.4px; }
                        Text {
                            text: (root.view-only ? "View only · " : "") + root.route + " · " + root.latency + " · " + root.fps + " fps";
                            color: Theme.subtle;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
                if !root.view-only: ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.scroll;
                    on: root.scroll-mode;
                    clicked => { root.scroll-mode = !root.scroll-mode; }
                }
                if !root.view-only: ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.keyboard;
                    on: root.keyboard-open;
                    clicked => {
                        if (root.keyboard-open) {
                            soft.clear-focus();
                            keys.focus();
                        } else {
                            soft.focus();
                        }
                    }
                }
            }
        }

        if root.monitors.length > 2: Rectangle {
            height: 46px;
            background: #121418;
            Flickable {
                content-width: Math.max(self.width, picker.width + 24px);
                picker := MonitorPicker {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    choices: root.monitors;
                    selected: root.monitor-selected;
                    pick(id) => { root.select-monitor(id); }
                }
            }
        }

        // Remote screen
        Rectangle {
            vertical-stretch: 1;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.frame;
                image-fit: contain;
                image-rendering: smooth;
            }
            if !root.has-frame: VerticalLayout {
                alignment: center;
                spacing: 14px;
                Spinner { }
                Text { text: "Waiting for the remote screen…"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
            }
            // A hardware keyboard types here; Back ends the session.
            keys := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Back) {
                        root.disconnect();
                        return accept;
                    }
                    root.key(e.text, true);
                    accept
                }
                key-released(e) => {
                    if (e.text != Key.Back) {
                        root.key(e.text, false);
                    }
                    accept
                }
                touch := TouchArea {
                    enabled: !root.view-only;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.dragging = false;
                            root.long-pressed = false;
                            root.last-x = self.mouse-x;
                            root.last-y = self.mouse-y;
                            if (!root.scroll-mode) {
                                root.pointer-moved(self.mouse-x, self.mouse-y, self.width, self.height);
                                long-press.running = true;
                            }
                        } else if (e.kind == PointerEventKind.up) {
                            long-press.running = false;
                            if (root.scroll-mode || root.long-pressed) {
                                // Nothing left to do.
                            } else if (root.dragging) {
                                root.pointer-button(1, false);
                            } else {
                                root.pointer-button(1, true);
                                root.pointer-button(1, false);
                            }
                            root.dragging = false;
                        } else if (e.kind == PointerEventKind.cancel) {
                            long-press.running = false;
                            if (root.dragging) {
                                root.pointer-button(1, false);
                            }
                            root.dragging = false;
                        }
                    }
                    moved => {
                        if (root.scroll-mode) {
                            // Content follows the finger, like scrolling a page on the phone.
                            root.scroll((self.mouse-x - root.last-x) * 1.5, (self.mouse-y - root.last-y) * 1.5);
                            root.last-x = self.mouse-x;
                            root.last-y = self.mouse-y;
                        } else if (root.dragging) {
                            root.pointer-moved(self.mouse-x, self.mouse-y, self.width, self.height);
                        } else if (!root.long-pressed && (abs(self.mouse-x - self.pressed-x) > 10px || abs(self.mouse-y - self.pressed-y) > 10px)) {
                            long-press.running = false;
                            root.dragging = true;
                            root.pointer-button(1, true);
                            root.pointer-moved(self.mouse-x, self.mouse-y, self.width, self.height);
                        }
                    }
                }
            }
            long-press := Timer {
                interval: 550ms;
                running: false;
                triggered => {
                    self.running = false;
                    root.long-pressed = true;
                    root.pointer-button(3, true);
                    root.pointer-button(3, false);
                }
            }
            // Scroll mode hint
            if root.scroll-mode: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 12px;
                height: 28px;
                width: hint.preferred-width + 24px;
                border-radius: 14px;
                background: #121418e0;
                border-width: 1px;
                border-color: Theme.border-strong;
                hint := Text { text: "Drag to scroll"; color: Theme.text-2; font-size: 12px; }
            }
        }

        // Keys phones lack, above the soft keyboard
        if root.keyboard-open: Rectangle {
            height: 50px;
            background: #121418;
            Rectangle { y: 0; height: 1px; background: #1f2228; }
            Flickable {
                content-width: Math.max(self.width, key-row.preferred-width);
                key-row := HorizontalLayout {
                    padding: 7px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: start;
                    KeyCap { label: "Esc"; clicked => { root.send-key(Key.Escape); } }
                    KeyCap { label: "Tab"; clicked => { root.send-key(Key.Tab); } }
                    KeyCap { label: "Ctrl"; on: root.ctrl; clicked => { root.ctrl = !root.ctrl; } }
                    KeyCap { label: "Alt"; on: root.alt; clicked => { root.alt = !root.alt; } }
                    KeyCap { label: "←"; clicked => { root.send-key(Key.LeftArrow); } }
                    KeyCap { label: "↑"; clicked => { root.send-key(Key.UpArrow); } }
                    KeyCap { label: "↓"; clicked => { root.send-key(Key.DownArrow); } }
                    KeyCap { label: "→"; clicked => { root.send-key(Key.RightArrow); } }
                    KeyCap { label: "Del"; clicked => { root.send-key(Key.Delete); } }
                    KeyCap { label: "Home"; clicked => { root.send-key(Key.Home); } }
                    KeyCap { label: "End"; clicked => { root.send-key(Key.End); } }
                    KeyCap { label: "Super"; clicked => { root.send-key(Key.Meta); } }
                }
            }
        }
    }

    // Receives the soft keyboard's text. The controller compares each edit with the previous text
    // and types the difference, so autocorrect and word composition come out right too. The
    // text starts as padding, so that Backspace on an "empty" field still is an edit.
    // Off-screen, so neither it nor its cursor handle is ever visible.
    soft := TextInput {
        x: -100px;
        y: -100px;
        width: 1px;
        height: 1px;
        opacity: 0;
        text <=> root.soft-text;
        single-line: true;
        input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
        edited => {
            root.soft-input(self.text, root.ctrl, root.alt);
            root.ctrl = false;
            root.alt = false;
        }
        accepted => { root.send-key(Key.Return); }
        key-pressed(e) => {
            if (e.text == Key.Back) {
                self.clear-focus();
                keys.focus();
                return accept;
            }
            reject
        }
    }
}
