import { Theme, Icons } from "theme.slint";
import { Logo, Icon, Field, PrimaryButton, LinkText, ErrorBox } from "widgets.slint";

component Point inherits HorizontalLayout {
    in property <string> text;
    spacing: 12px;
    Icon { y: (parent.height - self.height) / 2; d: Icons.check; color: Theme.accent; size: 16px; stroke: 2.2px; }
    Text { text: root.text; color: Theme.text-2; font-size: 14px; vertical-alignment: center; }
}

/// The sign-in, create-account and reset-password form (in the account dialog). An account is
/// optional: the device works by its ID without one.
export component LoginForm inherits VerticalLayout {
    in property <string> error;
    in property <bool> busy;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> password2;
    in-out property <bool> create-mode;
    /// "Forgot password": reset the password with the recovery key.
    in-out property <bool> recover-mode;
    in-out property <string> recovery-key;
    /// The account has two-factor authentication: ask for the code from the app.
    in property <bool> need-code;
    in-out property <string> code;
    /// The server only creates accounts with an invite code: ask for it.
    in property <bool> need-invite;
    in-out property <string> invite;
    /// Shown instead of the sign-in title when the password confirms an action
    /// (e.g. "Confirm with your password to turn on two-factor authentication.").
    in property <string> purpose;
    callback submit();
    spacing: root.recover-mode ? 14px : 16px;

    if root.recover-mode: HorizontalLayout {
        alignment: start;
        spacing: 6px;
        Icon { y: (parent.height - self.height) / 2; d: Icons.arrow-left; size: 15px; color: Theme.accent; }
        LinkText { text: "Back to sign in"; clicked => { root.recover-mode = false; } }
    }
    VerticalLayout {
        spacing: 6px;
        Text {
            text: root.purpose != "" ? "Confirm it's you" : root.recover-mode ? "Reset your password" : root.create-mode ? "Create an account" : "Sign in";
            color: Theme.text;
            font-size: 24px;
            font-weight: 600;
            letter-spacing: -0.5px;
        }
        if root.purpose != "": Text { text: root.purpose; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
        if root.recover-mode && root.purpose == "": Text {
            text: "Use the recovery key you saved when you created your account.";
            color: Theme.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        if !root.recover-mode && root.purpose == "": Text {
            text: root.create-mode
                ? "Optional. It syncs your address book and lets your own devices reach each other."
                : "Your devices and address book follow you to every computer you sign in on.";
            color: Theme.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        if !root.recover-mode && root.purpose == "": HorizontalLayout {
            alignment: start;
            spacing: 5px;
            Text { text: root.create-mode ? "Already have an account?" : "New here?"; color: Theme.muted; font-size: 14px; }
            LinkText {
                text: root.create-mode ? "Sign in" : "Create an account";
                font-size: 14px;
                clicked => { root.create-mode = !root.create-mode; }
            }
        }
    }

    Field { label: "Username"; placeholder: "your-name"; text <=> root.username; enabled: !root.busy && !root.need-code && root.purpose == ""; }
    if root.recover-mode: Field {
        label: "Recovery key";
        placeholder: "XXXX-XXXX-XXXX-…";
        font-family: Theme.mono;
        font-size: 14px;
        text <=> root.recovery-key;
        enabled: !root.busy;
    }
    if !root.recover-mode: VerticalLayout {
        spacing: 7px;
        HorizontalLayout {
            Text { text: "Password"; color: Theme.muted; font-size: 13px; }
            Rectangle { horizontal-stretch: 1; }
            if !root.create-mode && root.purpose == "": LinkText { text: "Forgot?"; clicked => { root.recover-mode = true; } }
        }
        Field {
            placeholder: root.create-mode ? "At least 8 characters" : "Your password";
            password: true;
            text <=> root.password;
            enabled: !root.busy && !root.need-code;
            accepted => { if (!root.create-mode) { root.submit(); } }
        }
    }
    if root.create-mode && !root.recover-mode: Field {
        label: "Confirm password";
        placeholder: "Repeat your password";
        password: true;
        text <=> root.password2;
        enabled: !root.busy;
    }
    if root.recover-mode: HorizontalLayout {
        spacing: 12px;
        Field {
            width: (parent.width - 12px) / 2;
            label: "New password";
            placeholder: "At least 8 characters";
            password: true;
            text <=> root.password;
            enabled: !root.busy;
        }
        Field {
            width: (parent.width - 12px) / 2;
            label: "Confirm";
            placeholder: "Repeat it";
            password: true;
            text <=> root.password2;
            enabled: !root.busy;
        }
    }
    if root.create-mode && !root.recover-mode && root.need-invite: Field {
        label: "Invite code";
        placeholder: "From the server's admin";
        font-family: Theme.mono;
        font-size: 14px;
        text <=> root.invite;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }
    if root.need-code: Field {
        label: "Code from your authenticator app";
        placeholder: "123 456";
        font-family: Theme.mono;
        font-size: 20px;
        text <=> root.code;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }

    if root.error != "": ErrorBox { text: root.error; }
    PrimaryButton {
        horizontal-stretch: 1;
        height: 46px;
        text: root.purpose != "" ? "Confirm" : root.recover-mode ? "Reset password" : root.create-mode ? "Create account" : "Sign in";
        busy: root.busy;
        clicked => { root.submit(); }
    }
}

/// The first start: which server, and what this computer is called. No account needed.
export component SetupForm inherits VerticalLayout {
    in property <string> error;
    in property <bool> busy;
    in-out property <string> server;
    in-out property <string> name;
    /// The phone: it reaches computers but isn't reached.
    in property <bool> mobile;
    callback submit();
    spacing: 18px;
    VerticalLayout {
        spacing: 6px;
        Text { text: "Get started"; color: Theme.text; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; }
        Text {
            text: root.mobile
                ? "This phone gets its own ID on your server, so you can reach your computers from it. You don't need an account."
                : "This computer gets its own ID on your server. You don't need an account: anyone with the ID can ask to connect, and you decide.";
            color: Theme.muted;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
    Field { label: "Server"; placeholder: "desk.example.com"; text <=> root.server; enabled: !root.busy; }
    Field {
        label: root.mobile ? "Name of this phone" : "Name of this computer";
        placeholder: root.mobile ? "e.g. my-phone" : "e.g. office-pc";
        text <=> root.name;
        enabled: !root.busy;
        accepted => { root.submit(); }
    }
    if root.error != "": ErrorBox { text: root.error; }
    PrimaryButton { horizontal-stretch: 1; height: 46px; text: "Continue"; busy: root.busy; clicked => { root.submit(); } }
    Text {
        text: "You can sign in to an account later, in Settings.";
        color: Theme.subtle;
        font-size: 12px;
        wrap: word-wrap;
    }
}

export component SetupPage inherits Rectangle {
    in property <string> error;
    in property <bool> busy;
    in-out property <string> server;
    in-out property <string> name;
    callback submit();
    background: Theme.bg;

    HorizontalLayout {
        // Story
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 48px;
            padding-left: 64px;
            padding-right: 56px;
            Logo { mark-size: 32px; font-size: 18px; }
            Rectangle { vertical-stretch: 1; }
            Text {
                text: "Your computers,\nwithin reach.";
                color: Theme.text;
                font-size: 44px;
                font-weight: 600;
                letter-spacing: -1.4px;
            }
            Rectangle { height: 18px; }
            Text {
                text: "Remote access you host yourself. Sessions are encrypted end to end, and every feature is free, for good.";
                color: Theme.muted;
                font-size: 16px;
                wrap: word-wrap;
            }
            Rectangle { height: 40px; }
            VerticalLayout {
                spacing: 14px;
                Point { text: "The relay only ever sees ciphertext"; }
                Point { text: "Connect by ID, no account needed"; }
                Point { text: "For Linux, Windows, macOS and Android"; }
            }
            Rectangle { vertical-stretch: 1; }
            Text { text: "Self-hosted · open protocol · free forever"; color: Theme.subtle; font-size: 12px; }
        }

        // Form
        Rectangle {
            width: 500px;
            background: #121418;
            Rectangle { x: 0; width: 1px; background: #1f2228; }
            SetupForm {
                alignment: center;
                padding-left: 60px;
                padding-right: 60px;
                server <=> root.server;
                name <=> root.name;
                error: root.error;
                busy: root.busy;
                submit => { root.submit(); }
            }
        }
    }
}
