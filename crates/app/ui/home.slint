import { Theme, Icons } from "theme.slint";
import { Logo, Icon, Field, PrimaryButton, GhostButton, LinkText, Card, SectionTitle, Avatar, Divider, NavItem } from "widgets.slint";
import { BookItem, BookList, BookView } from "book.slint";
import { SettingsView } from "settings.slint";
import { OrgsView, OrgItem, MemberItem, RuleItem, DeviceGroupItem, WorkerItem } from "orgs.slint";

export { BookItem, OrgItem, MemberItem, RuleItem, DeviceGroupItem, WorkerItem }

export struct DeviceItem {
    id: string,
    id-label: string,
    name: string,
    online: bool,
    is-self: bool,
}

/// A recently used connection target.
export struct RecentItem {
    id: string,
    label: string,
}

export enum HomeView { connect, book, devices, orgs, settings }

component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 6px;
    Text { text: root.title; color: Theme.text; font-size: 28px; font-weight: 600; letter-spacing: -0.6px; }
    if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
}

component DeviceRow inherits Rectangle {
    in property <DeviceItem> device;
    callback connect(string);
    callback remove(string);
    height: 62px;
    border-radius: 12px;
    background: ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: root.device.online ? Theme.accent-soft : #1f2228;
            Icon { d: Icons.monitor; size: 18px; stroke: 1.8px; color: root.device.online ? Theme.accent : Theme.subtle; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.device.name;
                    color: root.device.online || root.device.is-self ? Theme.text : #a3a9b4;
                    font-size: 14px;
                    font-weight: 500;
                }
                if root.device.is-self: Text { text: "· this computer"; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
            }
            Text { text: root.device.online ? "Online" : "Offline"; color: root.device.online ? Theme.accent : Theme.subtle; font-size: 12px; }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            width: 120px;
            text: root.device.id-label;
            color: Theme.muted;
            font-size: 13px;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
        if !root.device.is-self: GhostButton {
            y: (parent.height - self.height) / 2;
            button-height: 34px;
            icon: Icons.trash;
            fg: Theme.muted;
            clicked => { root.remove(root.device.id); }
        }
        if !root.device.is-self: GhostButton {
            y: (parent.height - self.height) / 2;
            width: 92px;
            button-height: 34px;
            text: "Connect";
            enabled: root.device.online;
            clicked => { root.connect(root.device.id); }
        }
        if root.device.is-self: Rectangle { width: 140px; }
    }
}

export component HomePage inherits Rectangle {
    in property <string> my-id;
    in-out property <string> my-device-name;
    in property <bool> signed-in;
    in property <string> username;
    in property <string> user-letter;
    in property <string> greeting;
    in property <string> fingerprint;
    in property <string> server-label;
    in property <bool> online;
    in property <string> status-text;
    in property <[DeviceItem]> devices;
    in property <[BookItem]> book;
    in property <[RecentItem]> recents;
    in property <bool> connect-busy;
    in-out property <string> connect-id;
    in property <bool> hosting-active;
    in property <string> hosting-peer;
    in-out property <HomeView> view: HomeView.connect;
    /// What the tour points at ("" when it is not running).
    in property <string> tour-target;
    callback start-tour();
    callback connect(string);
    callback connect-with-password(string);
    callback copy-id();
    callback stop-hosting();
    callback send-files();
    callback remove-device(string);
    callback book-edit(string);
    callback book-remove(string);
    callback book-add();

    // Settings
    in property <bool> unattended;
    in property <bool> account-2fa;
    in-out property <bool> own-devices;
    in-out property <bool> share-clipboard;
    in-out property <bool> allow-direct;
    in-out property <bool> run-in-background;
    in-out property <bool> start-at-login;
    callback rename-device(string);
    callback unattended-setup();
    callback unattended-disable();
    callback own-devices-changed(bool);
    callback share-clipboard-changed(bool);
    callback allow-direct-changed(bool);
    callback run-in-background-changed(bool);
    callback start-at-login-changed(bool);
    callback sign-in();
    callback create-account();
    callback sign-out();
    callback totp-setup();
    callback totp-disable();

    // Organisations
    in property <[OrgItem]> orgs;
    in property <string> org-selected;
    in property <string> org-name;
    in property <bool> org-admin;
    in property <bool> org-invited;
    in property <[BookItem]> org-devices;
    in property <[MemberItem]> org-members;
    in property <[RuleItem]> org-rules;
    in property <[DeviceGroupItem]> org-device-groups;
    in property <[WorkerItem]> org-workers;
    in property <bool> org-busy;
    callback org-select(string);
    callback org-create(string);
    callback org-add-member(string, string, bool);
    callback org-remove-member(string);
    callback org-add-rule(string, string);
    callback org-remove-rule(string, string);
    callback org-set-device-group(string, string);
    callback org-new-worker(string);
    callback org-revoke-worker(string);
    callback org-answer-invite(bool);
    background: Theme.bg;

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 228px;
            Rectangle { x: parent.width - 1px; width: 1px; background: #1f2228; }
            VerticalLayout {
                padding: 14px;
                padding-top: 20px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 20px;
                    Logo { mark-size: 30px; font-size: 17px; }
                }
                NavItem { text: "Connect"; icon: Icons.connect; active: root.view == HomeView.connect; clicked => { root.view = HomeView.connect; } }
                NavItem {
                    text: "Address book";
                    icon: Icons.book;
                    badge: root.book.length > 0 ? root.book.length : "";
                    active: root.view == HomeView.book;
                    clicked => { root.view = HomeView.book; }
                }
                if root.signed-in: NavItem {
                    text: "My devices";
                    icon: Icons.monitor;
                    badge: root.devices.length;
                    active: root.view == HomeView.devices;
                    clicked => { root.view = HomeView.devices; }
                }
                if root.signed-in: NavItem {
                    text: "Organisations";
                    icon: Icons.building;
                    badge: root.orgs.length > 0 ? root.orgs.length : "";
                    active: root.view == HomeView.orgs;
                    clicked => { root.view = HomeView.orgs; }
                }
                NavItem { text: "Settings"; icon: Icons.settings; active: root.view == HomeView.settings; clicked => { root.view = HomeView.settings; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 56px;
                    border-radius: 12px;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Avatar { y: (parent.height - self.height) / 2; letter: root.signed-in ? root.user-letter : ""; size: 32px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: root.signed-in ? root.username : "No account"; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    y: (parent.height - 6px) / 2;
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.online ? Theme.accent : Theme.warning;
                                }
                                Text { text: root.status-text; color: Theme.subtle; font-size: 12px; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if !root.signed-in: LinkText { y: (parent.height - self.height) / 2; text: "Sign in"; font-size: 12px; clicked => { root.sign-in(); } }
                    }
                }
            }
        }

        // Content
        VerticalLayout {
            horizontal-stretch: 1;
            if root.hosting-active: Rectangle {
                height: 52px;
                background: Theme.warning-soft;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 16px;
                    spacing: 12px;
                    Icon { y: (parent.height - self.height) / 2; d: Icons.eye; size: 17px; color: Theme.warning; }
                    Text {
                        text: root.hosting-peer + " is viewing and controlling this computer";
                        color: Theme.warning-text;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        y: (parent.height - self.height) / 2;
                        button-height: 34px;
                        text: "Send files";
                        icon: Icons.upload;
                        clicked => { root.send-files(); }
                    }
                    PrimaryButton {
                        y: (parent.height - self.height) / 2;
                        height: 34px;
                        danger: true;
                        text: "Stop sharing";
                        clicked => { root.stop-hosting(); }
                    }
                }
            }

            // Connect
            if root.view == HomeView.connect: VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-left: 36px;
                padding-right: 36px;
                spacing: 24px;
                PageHeader { title: root.greeting; subtitle: "Share this computer, or reach another one."; }
                HorizontalLayout {
                    spacing: 20px;
                    Card {
                        highlighted: root.tour-target == "id";
                        width: 330px;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 12px;
                            SectionTitle { text: "This computer"; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text {
                                    text: root.my-id;
                                    color: Theme.text;
                                    font-size: 30px;
                                    font-family: Theme.mono;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                GhostButton {
                                    y: (parent.height - self.height) / 2;
                                    button-height: 32px;
                                    icon: Icons.copy;
                                    clicked => { root.copy-id(); }
                                }
                            }
                            Text { text: root.my-device-name; color: Theme.muted; font-size: 13px; }
                            Divider { }
                            HorizontalLayout {
                                spacing: 10px;
                                Icon { y: (parent.height - self.height) / 2; d: Icons.shield; size: 16px; color: Theme.accent; }
                                Text { text: root.fingerprint; color: Theme.text-2; font-size: 13px; font-family: Theme.mono; vertical-alignment: center; }
                            }
                            Text {
                                text: "This computer's fingerprint. Compare it with the other side to rule out interception.";
                                color: Theme.subtle;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Card {
                        highlighted: root.tour-target == "connect";
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;
                            alignment: start;
                            SectionTitle { text: "Connect to a computer"; }
                            Text { text: "Remote ID"; color: Theme.muted; font-size: 13px; }
                            HorizontalLayout {
                                spacing: 10px;
                                Field {
                                    horizontal-stretch: 1;
                                    placeholder: "123 456 789";
                                    field-height: 52px;
                                    font-size: 22px;
                                    font-family: Theme.mono;
                                    text <=> root.connect-id;
                                    enabled: !root.connect-busy;
                                    accepted => { root.connect(root.connect-id); }
                                }
                                PrimaryButton {
                                    y: (parent.height - self.height) / 2;
                                    height: 52px;
                                    width: 124px;
                                    text: "Connect";
                                    busy: root.connect-busy;
                                    enabled: root.online;
                                    clicked => { root.connect(root.connect-id); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Nobody there?"; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
                                LinkText {
                                    text: "Connect with its password";
                                    font-size: 12px;
                                    clicked => { root.connect-with-password(root.connect-id); }
                                }
                            }
                            if root.recents.length > 0: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Recent"; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
                                for r in root.recents: Rectangle {
                                    height: 30px;
                                    width: chip.preferred-width + 24px;
                                    border-radius: 15px;
                                    background: chip-ta.has-hover ? Theme.hover : Theme.raised;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    chip := Text { text: r.label; color: Theme.text-2; font-size: 12px; }
                                    chip-ta := TouchArea { mouse-cursor: pointer; clicked => { root.connect(r.id); } }
                                }
                            }
                        }
                    }
                }
                Card {
                    highlighted: root.tour-target == "book";
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 10px;
                        padding-top: 18px;
                        spacing: 4px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-bottom: 6px;
                            spacing: 10px;
                            SectionTitle { text: "Address book"; }
                            Text { text: root.book.length; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            LinkText { text: "Manage"; clicked => { root.view = HomeView.book; } }
                        }
                        if root.book.length == 0: HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Computers you connect to can be kept here, with their unattended password if you like.";
                                color: Theme.subtle;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                        Flickable {
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: Math.max(self.height, home-book.preferred-height);
                            home-book := BookList { width: parent.width; items: root.book; compact: true; connect(id) => { root.connect(id); } }
                        }
                    }
                }
            }

            if root.view == HomeView.book: BookView {
                vertical-stretch: 1;
                items: root.book;
                signed-in: root.signed-in;
                connect(id) => { root.connect(id); }
                edit(id) => { root.book-edit(id); }
                remove(id) => { root.book-remove(id); }
                add => { root.book-add(); }
            }

            // My devices
            if root.view == HomeView.devices: VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-left: 36px;
                padding-right: 36px;
                spacing: 24px;
                PageHeader {
                    title: "My devices";
                    subtitle: "Devices signed in to " + root.username + ". Taking one off the account keeps its ID; it just leaves the account.";
                }
                Card {
                    vertical-stretch: 1;
                    Flickable {
                        content-width: self.width;
                        content-height: Math.max(self.height, devices-list.preferred-height);
                        devices-list := VerticalLayout {
                            width: parent.width;
                            padding: 10px;
                            alignment: start;
                            for d in root.devices: DeviceRow {
                                device: d;
                                connect(id) => { root.connect(id); }
                                remove(id) => { root.remove-device(id); }
                            }
                        }
                    }
                }
            }

            if root.view == HomeView.orgs: OrgsView {
                vertical-stretch: 1;
                orgs: root.orgs;
                selected: root.org-selected;
                org-name: root.org-name;
                org-admin: root.org-admin;
                org-invited: root.org-invited;
                devices: root.org-devices;
                members: root.org-members;
                rules: root.org-rules;
                device-groups: root.org-device-groups;
                workers: root.org-workers;
                busy: root.org-busy;
                select(id) => { root.org-select(id); }
                create(name) => { root.org-create(name); }
                connect(id) => { root.connect(id); }
                add-member(u, g, a) => { root.org-add-member(u, g, a); }
                remove-member(u) => { root.org-remove-member(u); }
                add-rule(g, d) => { root.org-add-rule(g, d); }
                remove-rule(g, d) => { root.org-remove-rule(g, d); }
                set-device-group(n, ids) => { root.org-set-device-group(n, ids); }
                new-worker(n) => { root.org-new-worker(n); }
                revoke-worker(k) => { root.org-revoke-worker(k); }
                answer-invite(join) => { root.org-answer-invite(join); }
            }

            if root.view == HomeView.settings: Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: Math.max(self.height, settings-view.preferred-height);
                settings-view := SettingsView {
                    width: parent.width;
                    device-name <=> root.my-device-name;
                    my-id: root.my-id;
                    fingerprint: root.fingerprint;
                    server-label: root.server-label;
                    unattended: root.unattended;
                    signed-in: root.signed-in;
                    username: root.username;
                    user-letter: root.user-letter;
                    account-2fa: root.account-2fa;
                    own-devices <=> root.own-devices;
                    share-clipboard <=> root.share-clipboard;
                    allow-direct <=> root.allow-direct;
                    run-in-background <=> root.run-in-background;
                    start-at-login <=> root.start-at-login;
                    tour-target: root.tour-target;
                    rename-device(n) => { root.rename-device(n); }
                    unattended-setup => { root.unattended-setup(); }
                    unattended-disable => { root.unattended-disable(); }
                    own-devices-changed(v) => { root.own-devices-changed(v); }
                    share-clipboard-changed(v) => { root.share-clipboard-changed(v); }
                    allow-direct-changed(v) => { root.allow-direct-changed(v); }
                    run-in-background-changed(v) => { root.run-in-background-changed(v); }
                    start-at-login-changed(v) => { root.start-at-login-changed(v); }
                    sign-in => { root.sign-in(); }
                    create-account => { root.create-account(); }
                    sign-out => { root.sign-out(); }
                    totp-setup => { root.totp-setup(); }
                    totp-disable => { root.totp-disable(); }
                    start-tour => { root.start-tour(); }
                }
            }
        }
    }
}
