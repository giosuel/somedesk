import { Theme, Icons } from "theme.slint";
import { Logo, Icon, Field, PrimaryButton, GhostButton, LinkText, Card, SectionTitle, Pill, Switch, Avatar, Divider, NavItem } from "widgets.slint";

export struct DeviceItem {
    id: string,
    id-label: string,
    name: string,
    online: bool,
    is-self: bool,
}

export struct ContactItem {
    username: string,
    letter: string,
    fingerprint: string,
    detail: string,
    /// Names of their devices allowed to connect without asking, or "".
    unattended: string,
}

/// A recently used connection target.
export struct RecentItem {
    id: string,
    label: string,
}

export enum HomeView { connect, devices, contacts, settings }

component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 6px;
    Text { text: root.title; color: Theme.text; font-size: 28px; font-weight: 600; letter-spacing: -0.6px; }
    if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
}

component DeviceRow inherits Rectangle {
    in property <DeviceItem> device;
    callback connect(string);
    height: 62px;
    border-radius: 12px;
    background: ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: root.device.online ? Theme.accent-soft : #1f2228;
            Icon { d: Icons.monitor; size: 18px; stroke: 1.8px; color: root.device.online ? Theme.accent : Theme.subtle; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.device.name;
                    color: root.device.online || root.device.is-self ? Theme.text : #a3a9b4;
                    font-size: 14px;
                    font-weight: 500;
                }
                if root.device.is-self: Text { text: "· this computer"; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
            }
            Text { text: root.device.online ? "Online" : "Offline"; color: root.device.online ? Theme.accent : Theme.subtle; font-size: 12px; }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            width: 120px;
            text: root.device.id-label;
            color: Theme.muted;
            font-size: 13px;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
        if !root.device.is-self: GhostButton {
            y: (parent.height - self.height) / 2;
            width: 92px;
            button-height: 34px;
            text: "Connect";
            enabled: root.device.online;
            clicked => { root.connect(root.device.id); }
        }
        if root.device.is-self: Rectangle { width: 92px; }
    }
}

component ContactRow inherits Rectangle {
    in property <ContactItem> contact;
    callback revoke(string);
    callback forget(string);
    height: content.preferred-height + 24px;
    border-radius: 12px;
    background: ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea { }
    content := HorizontalLayout {
        y: 12px;
        height: self.preferred-height;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Avatar { y: (parent.height - self.height) / 2; letter: root.contact.letter; size: 38px; }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: root.contact.username; color: Theme.text; font-size: 14px; font-weight: 500; }
            Text { text: root.contact.fingerprint; color: Theme.text-2; font-size: 12px; font-family: Theme.mono; }
            Text { text: root.contact.detail; color: Theme.subtle; font-size: 12px; }
            if root.contact.unattended != "": HorizontalLayout {
                spacing: 6px;
                Icon { y: (parent.height - self.height) / 2; d: Icons.key; size: 13px; color: Theme.warning; }
                Text {
                    text: "Can connect without asking: " + root.contact.unattended;
                    color: Theme.warning;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.contact.unattended != "": GhostButton {
            y: (parent.height - self.height) / 2;
            button-height: 34px;
            text: "Revoke access";
            clicked => { root.revoke(root.contact.username); }
        }
        GhostButton {
            y: (parent.height - self.height) / 2;
            button-height: 34px;
            text: "Forget";
            fg: Theme.muted;
            clicked => { root.forget(root.contact.username); }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 500; }
        Text { text: root.detail; color: Theme.subtle; font-size: 12px; wrap: word-wrap; }
    }
    Switch {
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        toggled(v) => { root.toggled(v); }
    }
}

export component HomePage inherits Rectangle {
    in property <string> my-id;
    in property <string> my-device-name;
    in property <string> username;
    in property <string> user-letter;
    in property <string> greeting;
    in property <string> fingerprint;
    in property <string> server-label;
    in property <bool> online;
    in property <string> status-text;
    in property <[DeviceItem]> devices;
    in property <[ContactItem]> contacts;
    in property <[RecentItem]> recents;
    in property <bool> connect-busy;
    in-out property <string> connect-id;
    in-out property <bool> auto-accept;
    in-out property <bool> share-clipboard;
    in-out property <bool> allow-direct;
    callback allow-direct-changed(bool);
    in property <bool> hosting-active;
    in property <string> hosting-peer;
    in-out property <HomeView> view: HomeView.connect;
    /// What the tour points at ("" when it is not running).
    in property <string> tour-target;
    callback start-tour();
    callback connect(string);
    callback copy-id();
    callback auto-accept-changed(bool);
    callback share-clipboard-changed(bool);
    callback sign-out();
    callback stop-hosting();
    callback send-files();
    callback revoke-contact(string);
    callback forget-contact(string);
    background: Theme.bg;

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 228px;
            Rectangle { x: parent.width - 1px; width: 1px; background: #1f2228; }
            VerticalLayout {
                padding: 14px;
                padding-top: 20px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 20px;
                    Logo { mark-size: 30px; font-size: 17px; }
                }
                NavItem { text: "Connect"; icon: Icons.connect; active: root.view == HomeView.connect; clicked => { root.view = HomeView.connect; } }
                NavItem {
                    text: "Devices";
                    icon: Icons.monitor;
                    badge: root.devices.length;
                    active: root.view == HomeView.devices;
                    clicked => { root.view = HomeView.devices; }
                }
                NavItem {
                    text: "Contacts";
                    icon: Icons.contacts;
                    badge: root.contacts.length > 0 ? root.contacts.length : "";
                    active: root.view == HomeView.contacts;
                    clicked => { root.view = HomeView.contacts; }
                }
                NavItem { text: "Settings"; icon: Icons.settings; active: root.view == HomeView.settings; clicked => { root.view = HomeView.settings; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 56px;
                    border-radius: 12px;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Avatar { y: (parent.height - self.height) / 2; letter: root.user-letter; size: 32px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: root.username; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    y: (parent.height - 6px) / 2;
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.online ? Theme.accent : Theme.warning;
                                }
                                Text { text: root.status-text; color: Theme.subtle; font-size: 12px; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 30px;
                            height: 30px;
                            border-radius: 8px;
                            background: out-ta.has-hover ? Theme.raised : transparent;
                            Icon { d: Icons.logout; size: 15px; color: Theme.subtle; }
                            out-ta := TouchArea { mouse-cursor: pointer; clicked => { root.sign-out(); } }
                        }
                    }
                }
            }
        }

        // Content
        VerticalLayout {
            horizontal-stretch: 1;
            if root.hosting-active: Rectangle {
                height: 52px;
                background: Theme.warning-soft;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 16px;
                    spacing: 12px;
                    Icon { y: (parent.height - self.height) / 2; d: Icons.eye; size: 17px; color: Theme.warning; }
                    Text {
                        text: root.hosting-peer + " is viewing and controlling this computer";
                        color: Theme.warning-text;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        y: (parent.height - self.height) / 2;
                        button-height: 34px;
                        text: "Send files";
                        icon: Icons.upload;
                        clicked => { root.send-files(); }
                    }
                    PrimaryButton {
                        y: (parent.height - self.height) / 2;
                        height: 34px;
                        danger: true;
                        text: "Stop sharing";
                        clicked => { root.stop-hosting(); }
                    }
                }
            }

            // Connect
            if root.view == HomeView.connect: VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-left: 36px;
                padding-right: 36px;
                spacing: 24px;
                PageHeader { title: root.greeting; subtitle: "Share this computer, or reach another one."; }
                HorizontalLayout {
                    spacing: 20px;
                    Card {
                        highlighted: root.tour-target == "id";
                        width: 330px;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 12px;
                            SectionTitle { text: "This computer"; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text {
                                    text: root.my-id;
                                    color: Theme.text;
                                    font-size: 30px;
                                    font-family: Theme.mono;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                GhostButton {
                                    y: (parent.height - self.height) / 2;
                                    button-height: 32px;
                                    icon: Icons.copy;
                                    clicked => { root.copy-id(); }
                                }
                            }
                            Text { text: root.my-device-name; color: Theme.muted; font-size: 13px; }
                            Divider { }
                            HorizontalLayout {
                                spacing: 10px;
                                Icon { y: (parent.height - self.height) / 2; d: Icons.shield; size: 16px; color: Theme.accent; }
                                Text { text: root.fingerprint; color: Theme.text-2; font-size: 13px; font-family: Theme.mono; vertical-alignment: center; }
                            }
                            Text {
                                text: "Your identity fingerprint. Compare it with the other side to rule out interception.";
                                color: Theme.subtle;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Card {
                        highlighted: root.tour-target == "connect";
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;
                            alignment: start;
                            SectionTitle { text: "Connect to a computer"; }
                            Text { text: "Remote ID"; color: Theme.muted; font-size: 13px; }
                            HorizontalLayout {
                                spacing: 10px;
                                Field {
                                    horizontal-stretch: 1;
                                    placeholder: "123 456 789";
                                    field-height: 52px;
                                    font-size: 22px;
                                    font-family: Theme.mono;
                                    text <=> root.connect-id;
                                    enabled: !root.connect-busy;
                                    accepted => { root.connect(root.connect-id); }
                                }
                                PrimaryButton {
                                    y: (parent.height - self.height) / 2;
                                    height: 52px;
                                    width: 124px;
                                    text: "Connect";
                                    busy: root.connect-busy;
                                    enabled: root.online;
                                    clicked => { root.connect(root.connect-id); }
                                }
                            }
                            if root.recents.length > 0: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Recent"; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
                                for r in root.recents: Rectangle {
                                    height: 30px;
                                    width: chip.preferred-width + 24px;
                                    border-radius: 15px;
                                    background: chip-ta.has-hover ? Theme.hover : Theme.raised;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    chip := Text { text: r.label; color: Theme.text-2; font-size: 12px; }
                                    chip-ta := TouchArea { mouse-cursor: pointer; clicked => { root.connect(r.id); } }
                                }
                            }
                        }
                    }
                }
                Card {
                    highlighted: root.tour-target == "devices";
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 10px;
                        padding-top: 18px;
                        spacing: 4px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-bottom: 6px;
                            spacing: 10px;
                            SectionTitle { text: "Your devices"; }
                            Text { text: root.devices.length; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            LinkText { text: "Manage"; clicked => { root.view = HomeView.devices; } }
                        }
                        Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                for d in root.devices: DeviceRow { device: d; connect(id) => { root.connect(id); } }
                            }
                        }
                    }
                }
            }

            // Devices
            if root.view == HomeView.devices: VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-left: 36px;
                padding-right: 36px;
                spacing: 24px;
                PageHeader { title: "Devices"; subtitle: "Computers signed in to your account. Any of them can be reached from the others."; }
                Card {
                    vertical-stretch: 1;
                    Flickable {
                        VerticalLayout {
                            padding: 10px;
                            alignment: start;
                            for d in root.devices: DeviceRow { device: d; connect(id) => { root.connect(id); } }
                        }
                    }
                }
            }

            // Contacts
            if root.view == HomeView.contacts: VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-left: 36px;
                padding-right: 36px;
                spacing: 24px;
                PageHeader {
                    title: "Contacts";
                    subtitle: "People you have connected with. SomeDesk remembers their identity and warns you if it ever changes.";
                }
                Card {
                    vertical-stretch: 1;
                    if root.contacts.length == 0: VerticalLayout {
                        alignment: center;
                        padding: 40px;
                        spacing: 10px;
                        Icon { x: (parent.width - self.width) / 2; d: Icons.contacts; size: 28px; color: Theme.faint; }
                        Text {
                            text: "No contacts yet. They appear here after your first session with someone.";
                            color: Theme.subtle;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if root.contacts.length > 0: Flickable {
                        VerticalLayout {
                            padding: 10px;
                            alignment: start;
                            for c in root.contacts: ContactRow {
                                contact: c;
                                revoke(u) => { root.revoke-contact(u); }
                                forget(u) => { root.forget-contact(u); }
                            }
                        }
                    }
                }
            }

            // Settings
            if root.view == HomeView.settings: VerticalLayout {
                vertical-stretch: 1;
                padding: 32px;
                padding-left: 36px;
                padding-right: 36px;
                spacing: 20px;
                alignment: start;
                PageHeader { title: "Settings"; }
                Card {
                    highlighted: root.tour-target == "sessions";
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        SectionTitle { text: "Sessions"; }
                        SettingRow {
                            title: "Unattended access";
                            detail: "Let my own devices connect to this computer without asking.";
                            checked <=> root.auto-accept;
                            toggled(v) => { root.auto-accept-changed(v); }
                        }
                        Divider { }
                        SettingRow {
                            title: "Share clipboard";
                            detail: "Copy on one computer, paste on the other during a session.";
                            checked <=> root.share-clipboard;
                            toggled(v) => { root.share-clipboard-changed(v); }
                        }
                        Divider { }
                        SettingRow {
                            title: "Direct connections";
                            detail: "Connect straight to the other computer when possible, for lower latency. This shows your IP address to the other side; when off, sessions always go through the relay.";
                            checked <=> root.allow-direct;
                            toggled(v) => { root.allow-direct-changed(v); }
                        }
                    }
                }
                Card {
                    highlighted: root.tour-target == "account";
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        SectionTitle { text: "Account"; }
                        HorizontalLayout {
                            spacing: 14px;
                            Avatar { y: (parent.height - self.height) / 2; letter: root.user-letter; size: 40px; }
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text { text: root.username; color: Theme.text; font-size: 15px; font-weight: 500; }
                                Text { text: root.server-label; color: Theme.subtle; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            GhostButton {
                                y: (parent.height - self.height) / 2;
                                text: "Take the tour";
                                icon: Icons.help;
                                clicked => { root.start-tour(); }
                            }
                            GhostButton {
                                y: (parent.height - self.height) / 2;
                                text: "Sign out";
                                icon: Icons.logout;
                                clicked => { root.sign-out(); }
                            }
                        }
                        Divider { }
                        HorizontalLayout {
                            spacing: 10px;
                            Icon { y: (parent.height - self.height) / 2; d: Icons.shield; size: 16px; color: Theme.accent; }
                            Text { text: "Identity fingerprint"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.fingerprint; color: Theme.text-2; font-size: 13px; font-family: Theme.mono; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
