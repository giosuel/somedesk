DATABASE_URL=postgres://somedesk:change-me@localhost/somedesk
# SOMEDESK_LISTEN=0.0.0.0:21116
# RUST_LOG=info
# Only let in devices signed in to an account on this server (by default, anyone may get an ID).
# SOMEDESK_ACCOUNTS_ONLY=true
# Who may create an account: open, invite (with a code from `somedesk-server invite`) or closed.
# Default: open, or invite with SOMEDESK_ACCOUNTS_ONLY.
# SOMEDESK_REGISTRATION=invite
# Limits per client. The defaults leave room for normal use, relayed sessions included.
# SOMEDESK_CONNECTIONS_PER_IP=64
# SOMEDESK_MAX_CONNECTIONS=20000
# SOMEDESK_RELAY_SESSIONS_PER_DEVICE=4
# SOMEDESK_RELAY_SESSIONS_PER_IP=16
# Average MB/s per direction of a relayed session (0: no limit).
# SOMEDESK_RELAY_MBPS=16
# Days to keep the audit log, and devices without an account that aren't seen anymore (0: keep).
# SOMEDESK_AUDIT_RETENTION_DAYS=90
# SOMEDESK_DEVICE_RETENTION_DAYS=180
